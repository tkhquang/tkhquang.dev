<div class="youtube-embed" data-waiting="Motion Picture">
    <div style="width: {{options.width}}; {{#options.margin}}margin: {{options.margin}};{{/options.margin}}">
        <div style="position: relative; padding-bottom: 56.25%; height: 0;">
            <iframe style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                src="https://www.youtube{{#options.nocookie}}-nocookie{{/options.nocookie}}.com/embed/{{#playlist}}videoseries?list={{/playlist}}{{id}}"
                title="YouTube {{#playlist}}playlist{{/playlist}}{{^playlist}}video{{/playlist}} {{id}}" loading="lazy"
                allow="autoplay; encrypted-media" allowfullscreen>
            </iframe>
        </div>
    </div>
</div>
